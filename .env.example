# ============================================================================
# CẤU HÌNH API KEY CHO SKKN 2026 PRO (Gemini API v5.0)
# ============================================================================

# 1. DÀNH CHO PRODUCTION TRÊN VERCEL (ẨN TUYỆT ĐỐI 100% TRÊN SERVER - KHUYÊN DÙNG):
# Cài đặt biến môi trường này trong Vercel Dashboard -> Settings -> Environment Variables
# (KHÔNG có tiền tố VITE_ để trình duyệt không bao giờ đọc được key thật)
GEMINI_API_KEYS=

# 2. DÀNH CHO CHẠY LOCAL CÁ NHÂN (.env.local - đã chặn trong .gitignore):
# Các key này chỉ được nạp vào RAM (không lưu xuống localStorage và luôn che dạng AIzaSy...xxxx)
VITE_GEMINI_API_KEYS=
